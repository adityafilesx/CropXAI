# ─── Environment ──────────────────────────────────────────────────────────────
# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=cropxai
WANDB_ENTITY=your_wandb_entity_here

# Data paths (override Hydra config defaults)
DATA_ROOT=/path/to/your/data
IBM_NASA_DATA_PATH=/path/to/ibm_nasa_dataset

# Experiment tracking
EXPERIMENT_ROOT=./experiments
ARTIFACT_ROOT=./artifacts

# Hardware
CUDA_VISIBLE_DEVICES=0

# Python
PYTHONPATH=.

# Hydra
HYDRA_FULL_ERROR=1
